# =============================================================================
# Agentic Search Intelligence System - configuration reference
# =============================================================================
# Copy to `.env` and adjust. Every value below has a working default, so the
# system starts with an empty .env in fully offline mode (fake LLM + mocked
# DataForSEO). Nothing here is required to run the test suite.
#
#   cp .env.example .env
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=agentic-search-intelligence
APP_ENVIRONMENT=local                 # local | test | production
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ----------------------------------------------------------------
# Must use the asyncpg driver. Host is `db` inside docker compose, `localhost` outside.
DATABASE_URL=postgresql+asyncpg://sightline:sightline@localhost:5432/sightline

# Host port the compose Postgres binds to. Change this (and the port in DATABASE_URL) if
# something already occupies 5432 on your machine.
POSTGRES_HOST_PORT=5432
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10.0
DATABASE_ECHO_SQL=false

# --- LLM provider ------------------------------------------------------------
# fake      -> deterministic, offline, zero-cost. Used by the whole test suite.
# openai    -> requires LLM_OPENAI_API_KEY
# anthropic -> requires LLM_ANTHROPIC_API_KEY
# gemini    -> requires LLM_GOOGLE_API_KEY
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_GOOGLE_API_KEY=

# --- DataForSEO --------------------------------------------------------------
# mock    -> recorded fixtures, no network, no credits consumed (default).
# sandbox -> DataForSEO's sandbox host; credentials required, returns dummy data.
# live    -> the real API; credentials required, consumes account credits.
DATAFORSEO_MODE=mock
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LIVE_BASE_URL=https://api.dataforseo.com
DATAFORSEO_SANDBOX_BASE_URL=https://sandbox.dataforseo.com
DATAFORSEO_CONNECT_TIMEOUT_SECONDS=5.0
DATAFORSEO_READ_TIMEOUT_SECONDS=30.0
DATAFORSEO_DEFAULT_LOCATION_CODE=2840      # United States
DATAFORSEO_DEFAULT_LANGUAGE_CODE=en

# --- Resilience (retries, backoff, circuit breaker) --------------------------
RESILIENCE_MAX_ATTEMPTS=3                  # total attempts, including the first
RESILIENCE_BACKOFF_INITIAL_SECONDS=0.5
RESILIENCE_BACKOFF_MULTIPLIER=2.0
RESILIENCE_BACKOFF_MAX_SECONDS=8.0
RESILIENCE_JITTER_RATIO=0.25               # 0.0 disables jitter
RESILIENCE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
RESILIENCE_CIRCUIT_BREAKER_RESET_SECONDS=30.0
RESILIENCE_CIRCUIT_BREAKER_HALF_OPEN_SUCCESSES=1

# --- Pipeline bounds ---------------------------------------------------------
PIPELINE_MAX_PLANNED_QUERIES=8
PIPELINE_MAX_RETRIEVAL_CONCURRENCY=4
PIPELINE_MIN_SUCCESSFUL_RETRIEVALS=1       # below this the run degrades to "partial"
PIPELINE_NODE_TIMEOUT_SECONDS=120.0

# --- Observability -----------------------------------------------------------
OBSERVABILITY_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
OBSERVABILITY_LOG_FORMAT=json              # json | console
OBSERVABILITY_LOG_NODE_PAYLOADS=true
OBSERVABILITY_MAX_LOGGED_PAYLOAD_CHARS=2000

# LangSmith is deferred (see CLAUDE.md S4). The seam is wired: set a key and the
# tracing callback attaches with no code change.
OBSERVABILITY_LANGSMITH_API_KEY=
OBSERVABILITY_LANGSMITH_PROJECT=agentic-search-intelligence
